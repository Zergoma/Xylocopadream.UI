<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xylocopadream.UI.Avalonia.Dialogs.PromptWindow"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" Click="OnOk" />
            <Button x:Name="CancelButton" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" Content="Annuler" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
