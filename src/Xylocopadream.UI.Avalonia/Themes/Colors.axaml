<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette modeled on JetBrains Rider (New UI, "Dark" theme).
        Xd.* brushes are for layouts built on the theme; the other keys override Fluent's defaults.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Xd.EditorBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="Xd.PanelBackground" Color="#2B2D30" />
    <SolidColorBrush x:Key="Xd.InputBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="Xd.PopupBackground" Color="#2B2D30" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Xd.Separator" Color="#1E1F22" />
    <SolidColorBrush x:Key="Xd.Border" Color="#393B40" />
    <SolidColorBrush x:Key="Xd.InputBorder" Color="#4E5157" />

    <!-- States -->
    <SolidColorBrush x:Key="Xd.Hover" Color="#393B40" />
    <SolidColorBrush x:Key="Xd.Pressed" Color="#43454A" />
    <SolidColorBrush x:Key="Xd.Selected" Color="#2E436E" />
    <SolidColorBrush x:Key="Xd.SelectedInactive" Color="#43454A" />
    <SolidColorBrush x:Key="Xd.Accent" Color="#3574F0" />
    <SolidColorBrush x:Key="Xd.AccentHover" Color="#3369D6" />
    <SolidColorBrush x:Key="Xd.Danger" Color="#DB5C5C" />
    <SolidColorBrush x:Key="Xd.DropTarget" Color="#3574F0" Opacity="0.35" />

    <!-- Text and icons -->
    <SolidColorBrush x:Key="Xd.Text" Color="#DFE1E5" />
    <SolidColorBrush x:Key="Xd.TextSecondary" Color="#868A91" />
    <SolidColorBrush x:Key="Xd.Icon" Color="#CED0D6" />

    <!-- ===== Fluent overrides ===== -->
    <Color x:Key="SystemAccentColor">#3574F0</Color>
    <Color x:Key="SystemAccentColorDark1">#3369D6</Color>
    <Color x:Key="SystemAccentColorLight1">#4682FA</Color>

    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

    <!-- Buttons: flat, outlined secondary buttons -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#393B40" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#43454A" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4E5157" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5A5D63" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5A5D63" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#393B40" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#DFE1E5" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#DFE1E5" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#DFE1E5" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6F737A" />
    <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

    <!-- Text boxes: dark field, blue border when focused -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1F22" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1F22" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4E5157" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5A5D63" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3574F0" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6F737A" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6F737A" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6F737A" />
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

    <!-- Combo boxes -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1E1F22" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1E1F22" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#4E5157" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5A5D63" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2D30" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#43454A" />

    <!-- Tree: compact rows, Rider selection colors -->
    <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>
    <x:Double x:Key="TreeViewItemIndent">14</x:Double>
    <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">6,0,4,0</Thickness>
    <x:Double x:Key="TreeViewItemExpandCollapseChevronSize">9</x:Double>
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#33393B40" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#393B40" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2E436E" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2E436E" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#2E436E" />
    <SolidColorBrush x:Key="TreeViewItemForeground" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPressed" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#DFE1E5" />

    <!-- Sliders: small thumb, thin track -->
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#4E5157" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#5A5D63" />

    <!-- Menus and tooltips -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B2D30" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#43454A" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2E436E" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2E436E" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#DFE1E5" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#868A91" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#A8ADB5" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#2B2D30" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#43454A" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#DFE1E5" />
</ResourceDictionary>
