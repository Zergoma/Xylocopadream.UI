    <StreamGeometry x:Key="Xd.Icon.Lock">M3.5,7.5 H12.5 V14.5 H3.5 Z M5.5,7.5 V5 A2.5,2.5 0 0 1 10.5,5 V7.5 M8,10 V12</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Shield">M8,1.5 L13.5,3.5 V8 C13.5,11 11,13.5 8,14.5 C5,13.5 2.5,11 2.5,8 V3.5 Z M5.5,8 L7.5,10 L10.5,6.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Thumbnails">M2.5,2.5 H6.5 V6.5 H2.5 Z M9.5,2.5 H13.5 V6.5 H9.5 Z M2.5,9.5 H6.5 V13.5 H2.5 Z M9.5,9.5 H13.5 V13.5 H9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Add">M8,2.5 V13.5 M2.5,8 H13.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Check">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Copy">M5.5,4.5 H13.5 V14.5 H5.5 Z M5.5,12.5 H2.5 V1.5 H10.5 V4.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Eye">M1.5,8 C3.5,4.5 12.5,4.5 14.5,8 C12.5,11.5 3.5,11.5 1.5,8 Z M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.EyeClosed">M1.5,8 C3.5,4.5 12.5,4.5 14.5,8 C12.5,11.5 3.5,11.5 1.5,8 Z M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8 M2.5,13.5 L13.5,2.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Grip">M6,3.5 V4.5 M10,3.5 V4.5 M6,7.5 V8.5 M10,7.5 V8.5 M6,11.5 V12.5 M10,11.5 V12.5</StreamGeometry>
</ResourceDictionary>
