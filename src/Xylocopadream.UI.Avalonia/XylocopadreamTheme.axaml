<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xylocopadream.UI.Avalonia.XylocopadreamTheme">
    <!--
        The whole theme in one element, in place of <FluentTheme />:
            <Application.Styles><xd:XylocopadreamTheme /></Application.Styles>
        Its own resources are looked up before those of the Fluent theme it contains, so Colors.axaml overrides Fluent.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Xylocopadream.UI.Avalonia/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://Xylocopadream.UI.Avalonia/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <FluentTheme />
    <StyleInclude Source="avares://Xylocopadream.UI.Avalonia/Themes/Controls.axaml" />
</Styles>
