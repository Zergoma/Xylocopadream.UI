<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        16x16 line icons in the spirit of the JetBrains "New UI" set.
        Drawn as strokes on half pixels; render them with a Path of class "icon" (see Theme.axaml).
    -->

    <!-- Navigation -->
    <StreamGeometry x:Key="Xd.Icon.Back">M13,8 H3 M7,4 L3,8 L7,12</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Forward">M3,8 H13 M9,4 L13,8 L9,12</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Up">M8,13 V3 M4,7 L8,3 L12,7</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Down">M8,3 V13 M4,9 L8,13 L12,9</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Refresh">M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.5,1.5 V4.5 H9.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Search">M10.5,6.5 A4,4 0 1 1 2.5,6.5 A4,4 0 1 1 10.5,6.5 M9.5,9.5 L14,14</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Close">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.ChevronRight">M6.5,4 L10.5,8 L6.5,12</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Hide">M3.5,8 H12.5</StreamGeometry>

    <!-- Items -->
    <StreamGeometry x:Key="Xd.Icon.Folder">M1.5,3.5 H6 L7.5,5 H14.5 V12.5 H1.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.FolderNew">M8.5,12.5 H1.5 V3.5 H6 L7.5,5 H14.5 V8 M12,9.5 V14.5 M9.5,12 H14.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.File">M3.5,1.5 H9.5 L12.5,4.5 V14.5 H3.5 Z M9.5,1.5 V4.5 H12.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Image">M2.5,2.5 H13.5 V13.5 H2.5 Z M2.5,11 L6,7.5 L9,10.5 L10.5,9 L13.5,12 M11.5,5.5 A1,1 0 1 1 9.5,5.5 A1,1 0 1 1 11.5,5.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Video">M1.5,3.5 H14.5 V12.5 H1.5 Z M6.5,5.5 V10.5 L10.5,8 Z</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Audio">M6,12 A2,2 0 1 1 2,12 A2,2 0 1 1 6,12 M6,12 V3 L13.5,1.5 V10.5 M13.5,10.5 A2,2 0 1 1 9.5,10.5 A2,2 0 1 1 13.5,10.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Document">M3.5,1.5 H9.5 L12.5,4.5 V14.5 H3.5 Z M9.5,1.5 V4.5 H12.5 M5.5,8 H10.5 M5.5,10.5 H10.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Archive">M2.5,2.5 H13.5 V13.5 H2.5 Z M7.5,2.5 V4 H8.5 V5.5 H7.5 V7 H8.5 V8.5 M7,8.5 H9 V11 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Form">M2.5,2.5 H13.5 V13.5 H2.5 Z M4.5,5.5 H6 M8,5.5 H11.5 M4.5,8 H6 M8,8 H11.5 M4.5,10.5 H6 M8,10.5 H11.5</StreamGeometry>

    <!-- Actions -->
    <StreamGeometry x:Key="Xd.Icon.Import">M8,1.5 V9.5 M4.5,6 L8,9.5 L11.5,6 M2.5,11 V14 H13.5 V11</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.ImportFolder">M1.5,3.5 H6 L7.5,5 H14.5 V12.5 H1.5 Z M8,6.5 V10.5 M6,8.5 L8,10.5 L10,8.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Export">M8,10 V1.5 M4.5,5 L8,1.5 L11.5,5 M2.5,11 V14 H13.5 V11</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Rename">M10.5,2.5 L13.5,5.5 L5.5,13.5 H2.5 V10.5 Z M9,4 L12,7</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Move">M1.5,8 H10 M7,5 L10,8 L7,11 M13.5,2.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="Xd.Icon.Tag">M1.5,2.5 V7.5 L8.5,14.5 L14,9 L7,2 H2 Z M5.5,5.5 A1,1 0 1 1 3.5,5.5 A1,1 0 1 1 5.5,5.5</StreamGeometry>
