<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Control styles inspired by JetBrains Rider: dense, flat, 13 px text, 16 px line icons.
        Opt-in looks are style classes (Classes="tool", "accent", "danger", "link", "chip"...): see README.md.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Xd.EditorBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Xd.Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Xd.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Icons: <Path Classes="icon" Data="{StaticResource Xd.Icon.Folder}" /> ===== -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{DynamicResource Xd.Icon}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.folder">
        <Setter Property="Stroke" Value="{DynamicResource Xd.FolderIcon}" />
    </Style>
    <Style Selector=":disabled Path.icon">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Flat toolbar buttons: icon only or icon + text, highlighted on hover -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Pressed}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Tool window stripe buttons (left edge), checked when their tool window is open -->
    <Style Selector="ToggleButton.stripe">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.stripe:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="ToggleButton.stripe:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Selected}" />
    </Style>
    <Style Selector="ToggleButton.stripe:checked Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource Xd.IconOnSelected}" />
    </Style>

    <!-- RailChoiceGroup / ThemeSwitcher: white icon on the accent pill -->
    <Style Selector="Button.rail-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Hover}" />
    </Style>
    <Style Selector="Button.rail-choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.rail-choice.selected Path.icon">
        <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- ColorPicker presets keep their color under the pointer, with a ring -->
    <Style Selector="Button.xd-preset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.Text}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Breadcrumb: no chevron before the first segment, the last one in bold -->
    <Style Selector=":is(Control).xd-first Path.xd-crumb-chevron">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(Control).xd-last Button.crumb">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- RadialMenu: bubbles, and the one the pointer points to -->
    <Style Selector="Border.xd-radial-bubble">
        <Setter Property="Background" Value="{DynamicResource Xd.PopupBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.PopupBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.xd-radial-bubble.xd-radial-highlight">
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.xd-radial-item">
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!-- Item being dragged by a xd:Reorder handle -->
    <Style Selector=":is(Control).xd-dragging">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="ZIndex" Value="1" />
    </Style>

    <!-- Destructive action button (delete, errors) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#C94F4F" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B54545" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Link-like button (secondary actions in forms) -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Xd.Link}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Xd.LinkHover}" />
    </Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Xd.TextDisabled}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="Height" Value="3" />
    </Style>

    <!-- 1 px separators between panels -->
    <Style Selector="GridSplitter.thin">
        <Setter Property="Background" Value="{DynamicResource Xd.Separator}" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="Width" Value="1" />
    </Style>

    <!-- Vertical separator between groups of toolbar buttons -->
    <Style Selector="Border.toolbar-separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource Xd.Border}" />
    </Style>

    <!-- Panels: tool windows and bars (main toolbar, status bar) -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource Xd.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.Separator}" />
    </Style>

    <!-- Small flat buttons, e.g. a breadcrumb in a status bar -->
    <Style Selector="Button.crumb">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Error message box in a form: <Border Classes="error"><TextBlock Text="..." /></Border> -->
    <Style Selector="Border.error">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Xd.ErrorBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xd.ErrorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.error > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Xd.Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Tile lists (ListBox with a WrapPanel): compact, blue selection when focused, grey otherwise -->
    <Style Selector="ListBox.tiles ListBoxItem">
        <Setter Property="Padding" Value="6,6,6,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.TileHover}" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.SelectedInactive}" />
    </Style>
    <Style Selector="ListBox.tiles:focus-within ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.Selected}" />
    </Style>

    <!-- Drop target highlight, toggled from code during a drag and drop -->
    <Style Selector="TreeViewItem.drop-target /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Xd.DropTarget}" />
    </Style>
    <Style Selector="ListBoxItem.drop-target /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Xd.DropTarget}" />
    </Style>

    <!-- ===== Chips: small colored pills (tags...) ===== -->
    <Style Selector="Button.chip">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MaxWidth" Value="120" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chip /template/ ContentPresenter">
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.chip-more">
        <Setter Property="Background" Value="{DynamicResource Xd.ChipMore}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,1,6,2" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="Border.chip-more > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Viewer overlay buttons (always on dark background) ===== -->
    <Style Selector="Button.overlay">
        <Setter Property="Background" Value="#40FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlay:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#70FFFFFF" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.overlay:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="Foreground" Value="#60FFFFFF" />
    </Style>
</Styles>
