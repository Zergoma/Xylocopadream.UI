<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Avalonia theme and controls inspired by JetBrains Rider: dark palette, 16 px line icons, dense styles, zoomable image viewer, dialogs.</Description>
    <PackageTags>avalonia;theme;dark;rider;icons;controls</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xylocopadream.UI.Avalonia.Tests" />
  </ItemGroup>
</Project>
